# Displays (mostly docked, hdmi is main)
set $main_display HDMI-A-1
set $secondary_display eDP-1

exec swayidle -w \
    timeout 600 'loginctl suspend' \
    before-sleep 'swaylock -f'

exec_always ~/scripts/post-suspend.sh

# Touchpad
input type:touchpad {
  natural_scroll enabled
  click_method clickfinger
  clickfinger_button_map lrm
}

### Output Configuration
output $main_display allow_tearing yes
output $main_display max_render_time off
output * background ~/Pictures/wallpapers/gruvmoon.png fill
