# Displays
set $main_display DP-1
set $secondary_display DP-2

# immediate start
exec {
  swayidle -w timeout 900 'loginctl suspend' before-sleep 'true'
}

# Delayed start (hacky solution for apps that require pipewire)
exec {
  sleep $delayed_start_sec && birdtray
  sleep $delayed_start_sec && flatpak run --branch=stable --arch=x86_64 --command=com.discordapp.Discord --file-forwarding com.discordapp.Discord
}

exec_always ~/scripts/post-suspend.sh

### Output Configuration
output $main_display render_bit_depth 10
output $main_display allow_tearing yes
output $main_display max_render_time off
output * background ~/Pictures/wallpapers/darkmoon.png fill

# HDR Toggle (for HDR games, looks terrible with SDR content)
bindsym $mod+Shift+r output $main_display hdr toggle
